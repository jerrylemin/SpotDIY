{
  "name": "spotdiy",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Windows music player with unified source fusion.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
